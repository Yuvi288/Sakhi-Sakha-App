<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/lbg"
    tools:context=".HomeActivity">

    <!-- App Logo with improved sizing and constraints -->
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="120sp"
        android:layout_height="120sp"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ssmodified"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30sp" />

    <!-- Welcome Text with better typography -->
    <TextView
        android:id="@+id/welcomeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Sakhi and Sakha \n Studio And Academy!"
        android:textSize="24sp"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/logoImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/subtitleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your beauty salon management solution"
        android:textSize="16sp"
        android:textColor="#555555"
        android:fontFamily="sans-serif-light"
        app:layout_constraintTop_toBottomOf="@id/welcomeText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp" />

    <!-- Card for buttons -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toBottomOf="@id/subtitleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/Myprofile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Profile"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:padding="12dp"
                app:cornerRadius="8dp"
                app:iconGravity="start"
                app:iconPadding="8dp"
                app:backgroundTint="#661E08"
                android:layout_marginBottom="12dp" />

            <!-- Appointments Button with icon -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageAppointmentsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage Appointments"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:padding="12dp"
                app:cornerRadius="8dp"
                app:iconGravity="start"
                app:iconPadding="8dp"
                app:backgroundTint="#FF5722"
                android:layout_marginBottom="12dp" />

            <!-- Services Button with icon -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/manageServicesButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Manage Services"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:padding="12dp"
                app:cornerRadius="8dp"
                app:iconGravity="start"
                app:iconPadding="8dp"
                app:backgroundTint="#E91E63"
                android:layout_marginBottom="12dp" />

            <!-- Staff Button with icon -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ManageStaff"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Staff Details"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:padding="12dp"
                app:cornerRadius="8dp"
                app:iconGravity="start"
                app:iconPadding="8dp"
                app:backgroundTint="#9C27B0"
                android:layout_marginBottom="12dp" />

            <!-- Reports Button with icon -->

            <!-- Divider -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/academyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:padding="12dp"
                android:text="Academy"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:backgroundTint="#3F51B5"
                app:cornerRadius="8dp"
                app:iconGravity="start"
                app:iconPadding="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <!-- Logout Button with icon -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Logout"
                android:textColor="#757575"
                android:textSize="16sp"
                android:padding="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:cornerRadius="8dp"
                app:iconGravity="start"
                app:iconPadding="8dp"
                app:iconTint="#757575"
                app:strokeColor="#BDBDBD" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Footer text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="© 2025 Parlour Management System"
        android:textSize="12sp"
        android:textColor="#757575"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>